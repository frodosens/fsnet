  "additional_regressions": [
    "exact execution cancellation separated from reusable connection lifetime",
    "expired Lua coroutine cannot stage a timer into a newer transaction",
    "identity/base/AOI callbacks may reenter stop without iterator or reference invalidation",
    "storage admission allocation failure completes or restores accepted request",
    "critical initialization failure during SIGTERM drain is still nonzero exit"
  ],
  "capacity": {
    "C01": "permanent destroyed sources without pending outbox retired using registry CAS; live/missing sources and inbox watermarks retained",
    "C02": "Memory backend remains a development backend with full-table candidate commits",
    "C03": "field network deltas still commit complete entity records"
  },
  "deployment_changes": {
    "transport": 2,
    "user_lua_gc": "registration forbidden; native userdata finalizers retained",
    "runtime.start": "finite critical initialization",
    "runtime.background": "long-lived noncritical work",
    "postgres_dns": "numeric hostaddr required for DNS names; host still used for TLS verification",
    "service_storage": "persistent() capability required"
  },
  "limits": [
    "Local fixtures and sanitizer runs do not certify production SLO or multi-machine database HA.",
    "Callbacks, custom Storage and operating-system file I/O need their own bounded contracts.",
    "Hot reload/schema migration and complete authenticated encrypted P2P remain outside this fix."
  ],
