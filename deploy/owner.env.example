# Copy to /etc/fsnet/owner-a.env; protect config and private keys (0600).
FSNET_STORAGE_URI=file:/var/lib/fsnet/state
FSNET_BIND_ADDRESS=127.0.0.1
FSNET_CLUSTER_TOKEN=
FSNET_TLS_CA=/etc/fsnet/pki/ca.pem
FSNET_TLS_CERTIFICATE=/etc/fsnet/pki/owner-a.pem
FSNET_TLS_KEY=/etc/fsnet/pki/owner-a.key
FSNET_ENTITY_LEASE_MS=60000
FSNET_METRICS_FILE=/var/lib/fsnet/owner-a.json

# Optional directed handoff: configure BOTH on all owners, with separate owner pins.
# FSNET_ENTITY_ENDPOINTS=/etc/fsnet/endpoints.tsv
# FSNET_OWNER_PINS=/etc/fsnet/owner-pins.tsv
